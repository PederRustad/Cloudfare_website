---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { articles, getArticleBySlug } from "../../data/articles";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const articleData = article ?? getArticleBySlug(Astro.params.slug ?? "");

if (!articleData) {
  throw new Error("Artikkel ikke funnet");
}

const target = `/innsikt/${articleData.slug}`;
---

<SiteLayout
  title={`${articleData.title} | Bitcoin Strategi`}
  description={articleData.description}
  canonicalPath={target}
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${target}`} />

  <section class="hero reveal delay-1 section">
    <p class="eyebrow">Omdirigering</p>
    <h1>Denne artikkelen er flyttet.</h1>
    <p class="lead">
      Du blir sendt videre til <a href={target}>{target}</a>. Hvis ikke, bruk
      knappen under.
    </p>
    <div class="inline-actions">
      <a class="btn primary" href={target}>Gå til artikkelen</a>
      <a class="btn ghost" href="/innsikt">Til Innsikt</a>
    </div>
  </section>
</SiteLayout>
