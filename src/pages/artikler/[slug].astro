---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const artikler = await getCollection("artikler", ({ data }) => !data.draft);
  return artikler.map((artikkel) => ({
    params: { slug: artikkel.id },
    props: { artikkel }
  }));
}

const { artikkel } = Astro.props;
const { Content } = await render(artikkel);
---

<SiteLayout
  title={`${artikkel.data.title} | Bitcoin Strategi`}
  description={artikkel.data.description}
>
  <article class="artikkel section reveal delay-1">
    <h1>{artikkel.data.title}</h1>
    <time datetime={artikkel.data.published.toISOString()}>
      {artikkel.data.published.toLocaleDateString("nb-NO", { dateStyle: "long" })}
    </time>
    <div class="artikkel-innhold">
      <Content />
    </div>
    <p class="artikkel-tilbake"><a href="/artikler">← Alle artikler</a></p>
  </article>
</SiteLayout>
