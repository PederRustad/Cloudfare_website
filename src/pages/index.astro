---
import BrandMark from "../components/BrandMark.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Bitcoin Strategi | Strategisk rådgivning"
  description="Vi hjelper norske bedrifter og privatpersoner med å innføre en bitcoinstrategi med tydelige rammer og trygg gjennomføring."
>
  <section class="home-minimal reveal delay-1">
    <div class="home-logo" aria-hidden="true">
      <BrandMark />
    </div>

    <p class="home-statement">
      Vi hjelper norske bedrifter og privatpersoner med å innføre en
      bitcoinstrategi med tydelige rammer, kontroll og langsiktighet.
    </p>

    <div class="home-links">
      <a href="/smb">For bedrifter</a>
      <a href="/privat">For privatpersoner</a>
      <a href="/contact">Kontakt</a>
    </div>
  </section>
</SiteLayout>
