---
import BrandMark from "./BrandMark.astro";

const pathname = Astro.url.pathname;
const segment = Astro.url.searchParams.get("segment");

const links = [
  { href: "/", label: "Hjem" },
  { href: "/smb", label: "For bedrifter" },
  { href: "/privat", label: "For privatpersoner" },
  { href: "/compliance", label: "Rammeverk" },
  { href: "/bransjer", label: "Bransjer" },
  { href: "/innsikt", label: "Innsikt" },
  { href: "/contact", label: "Kontakt" }
];

function isActive(path: string, currentSegment: string | null, href: string): boolean {
  const hrefUrl = new URL(href, Astro.url);
  const hrefPath = hrefUrl.pathname;
  const hrefSegment = hrefUrl.searchParams.get("segment");

  if (hrefSegment) {
    return path === hrefPath && currentSegment === hrefSegment;
  }

  if (hrefPath === "/") {
    return path === "/";
  }

  if (hrefPath === "/privat") {
    return path === "/privat" || (path === "/contact" && currentSegment === "privat");
  }

  if (path !== hrefPath && !path.startsWith(`${hrefPath}/`)) {
    return false;
  }

  return currentSegment === null;
}
---

<header class={pathname === "/" ? "site-header home-nav-only" : "site-header"}>
  {
    pathname !== "/" && (
      <a class="brand" href="/" aria-label="Gå til forsiden">
        <span class="brand-mark" aria-hidden="true">
          <BrandMark />
        </span>
        <span class="brand-copy">
          bitcoinstrategi.no
          <small>Strategisk bitcoin-rådgivning</small>
        </span>
      </a>
    )
  }

  <button class="menu-trigger" aria-label="Åpne meny" data-menu-trigger>
    Meny
  </button>

  <nav class="site-nav" data-site-nav>
    {
      links.map((link) => (
        <a
          class={isActive(pathname, segment, link.href) ? "active" : ""}
          href={link.href}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
